# Marketing site development (Vite server: http://localhost:5174)
VITE_API_URL=http://localhost:5000/api

# Dashboard used by the Log In / Get Started links.
# V2 runs on http://localhost:5173 by default.
VITE_APP_URL=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Notes:
# - Only values prefixed with VITE_ are exposed to the frontend.
# - Never put secrets here. See docs/security.md.
