# Marketing site development (Vite server: http://localhost:5174)
VITE_API_URL=http://localhost:5000/api
# Optional: explicit Socket.IO origin. Defaults to the API origin.
# VITE_SOCKET_URL=https://api.example.com
# Set to false only to disable live updates.
# VITE_ENABLE_SOCKET=true

# Primary dashboard (V2) used by Log In / Get Started links
VITE_APP_URL=http://localhost:5175

# Legacy dashboard (V1) for existing users
VITE_V1_APP_URL=http://localhost:5173

VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Notes:
# - Only values prefixed with VITE_ are exposed to the frontend.
# - Never put secrets here. See docs/security.md.
