# Marketing Site (Local: http://localhost:5174 | Production: https://webpulseanalytics.tech)
# Backend API (Local: http://localhost:3000/api | Production: https://api.webpulseanalytics.tech/api)
VITE_API_URL=http://localhost:3000/api
# Optional explicit Socket.IO origin (Local: http://localhost:3000 | Production: https://api.webpulseanalytics.tech)
# VITE_SOCKET_URL=https://api.webpulseanalytics.tech
# VITE_ENABLE_SOCKET=true

# Primary Stable Dashboard (V1) used by Log In / Register / Get Started links
# Local: http://localhost:5173 | Production: https://app.webpulseanalytics.tech
VITE_APP_URL=http://localhost:5173
VITE_V1_APP_URL=http://localhost:5173

# Optional Beta Dashboard (V2)
# Local: http://localhost:5175 | Production: https://beta.webpulseanalytics.tech
VITE_V2_APP_URL=http://localhost:5175

# Marketing Site URL
# Local: http://localhost:5174 | Production: https://webpulseanalytics.tech
VITE_MARKETING_URL=http://localhost:5174

VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Notes:
# - Only values prefixed with VITE_ are exposed to the frontend.
# - Never put secrets here. See docs/security.md.
