VITE_API_URL=http://localhost:5000/api
# Optional: explicit Socket.IO origin. Defaults to the API origin.
# VITE_SOCKET_URL=https://api.example.com
# Set to false only to disable live updates.
# VITE_ENABLE_SOCKET=true
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Notes:
# - V1 runs on http://localhost:5173 by default.
# - Only values prefixed with VITE_ are exposed to the frontend.
# - Never put secrets here. See docs/security.md.
