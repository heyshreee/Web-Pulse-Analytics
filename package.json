{
  "name": "webpulse-analytics-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "WebPulse Analytics Monorepo (Marketing, V1 Dashboard, V2 Dashboard, and Backend API)",
  "scripts": {
    "dev:marketing": "npm --prefix apps/marketing run dev",
    "build:marketing": "npm --prefix apps/marketing run build",
    "lint:marketing": "npm --prefix apps/marketing run lint",
    "preview:marketing": "npm --prefix apps/marketing run preview",
    "dev:v1": "npm --prefix apps/v1 run dev",
    "build:v1": "npm --prefix apps/v1 run build",
    "lint:v1": "npm --prefix apps/v1 run lint",
    "preview:v1": "npm --prefix apps/v1 run preview",
    "dev:v2": "npm --prefix apps/v2 run dev -- --port 5175",
    "build:v2": "npm --prefix apps/v2 run build",
    "lint:v2": "npm --prefix apps/v2 run lint",
    "preview:v2": "npm --prefix apps/v2 run preview -- --port 4175",
    "dev:backend": "npm --prefix backend run dev",
    "start:backend": "npm --prefix backend run start",
    "test:backend": "npm --prefix backend test",
    "build:all": "npm run build:marketing && npm run build:v1 && npm run build:v2",
    "lint:all": "npm run lint:marketing && npm run lint:v1 && npm run lint:v2",
    "check:backend": "node scripts/check-syntax.mjs backend/src"
  },
  "keywords": [
    "analytics",
    "privacy-friendly",
    "real-time",
    "monorepo"
  ],
  "author": "heyshreee",
  "license": "MIT"
}
