# Backend (.env) — example only. DO NOT COMMIT REAL VALUES.

# Server
PORT=5000
NODE_ENV=development

# App URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Security
JWT_SECRET=replace-with-a-strong-random-string
CSRF_SECRET=replace-with-another-strong-random-string

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Third-party services (optional)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
PRIVACY_EMAIL=privacy@yourdomain.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_WHATSAPP_NUMBER=your-twilio-whatsapp-number

# Notes:
# - Copy this file to `.env` and fill real values locally.
# - Never commit `.env` or files with real credentials.
# - See docs/security.md for guidance on secret handling.
