# Backend (.env) — example only. DO NOT COMMIT REAL VALUES.

# Server
PORT=5000
NODE_ENV=development

# App URLs & Architecture
# Architecture:
# - Marketing:  https://webpulseanalytics.tech       (Local: http://localhost:5174)
# - Stable V1:  https://app.webpulseanalytics.tech   (Local: http://localhost:5173)
# - Beta V2:    https://beta.webpulseanalytics.tech  (Local: http://localhost:5175)
# - Backend:    https://api.webpulseanalytics.tech   (Local: http://localhost:3000)

# FRONTEND_URL is the primary dashboard used for email links (defaults to Stable V1).
# Production: https://app.webpulseanalytics.tech
FRONTEND_URL=http://localhost:5173

# Comma-separated trusted browser origins for credentialed API + Socket.IO.
# Include marketing, V1, V2, and any preview origins.
# Production: https://webpulseanalytics.tech,https://www.webpulseanalytics.tech,https://app.webpulseanalytics.tech,https://beta.webpulseanalytics.tech
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175
BACKEND_URL=http://localhost:3000

# Optional cookie domain for cross-subdomain authentication in production:
# COOKIE_DOMAIN=.webpulseanalytics.tech

# Security
JWT_SECRET=replace-with-a-strong-random-string
CSRF_SECRET=replace-with-another-strong-random-string

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Third-party services (optional)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
PRIVACY_EMAIL=privacy@yourdomain.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_WHATSAPP_NUMBER=your-twilio-whatsapp-number

# Notes:
# - Copy this file to `.env` and fill real values locally.
# - Never commit `.env` or files with real credentials.
# - See docs/security.md for guidance on secret handling.
